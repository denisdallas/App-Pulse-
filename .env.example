# PostgreSQL is required for all authenticated/domain APIs. Use the pooled URL for app traffic.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Direct (non-pooled) URL for schema migrations. If DATABASE_URL uses a Neon -pooler host, set this.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Required: generate a unique value with at least 32 random bytes. Never commit the real value.
AUTH_SESSION_SECRET=replace-this-placeholder-with-a-random-secret-of-at-least-32-bytes

# Optional server-side Google Gemini API key. Without it, analysis uses only evidence-backed deterministic logic.
GEMINI_API_KEY=

# Production must choose "worker" (run `bun run worker` as a separate process) or
# "http_trigger" (configure an authenticated external scheduler to POST the worker endpoint).
JOB_EXECUTION_MODE=
# Use a unique value with at least 32 bytes for the external scheduler's Bearer token.
JOB_TRIGGER_SECRET=
JOB_WORKER_POLL_MS=2000
JOB_STALE_SECONDS=180
DB_POOL_SIZE=5
PORT=3000
NODE_ENV=development

# Optional direct, isolated, disposable PostgreSQL database used only by `bun run test:db`.
# Never point this at the production database.
TEST_DATABASE_URL=
