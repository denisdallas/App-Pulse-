# Local development defaults to durable SQLite. Production requires PostgreSQL.
NODE_ENV=development
PORT=3000
APP_SQLITE_PATH=
DATABASE_URL=

# Required in production for shared authentication rate limiting.
AUTH_RATE_LIMIT_SECRET=

# Optional: enables Gemini-powered analysis.
GEMINI_API_KEY=

# Optional one-time administrator bootstrap. Remove after initial setup.
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_ADMIN_NAME=

# Optional live email delivery. Leave empty to keep delivery disabled.
# Configure either the complete SMTP set or RESEND_API_KEY.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
OUTREACH_FROM_EMAIL=
